CNI_VERSION=v1.2.0
CALICO_DIR=/etc/cni/net.d
ETCD_ENDPOINTS=http://172.31.17.19:2379
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
CALICO_VERSION=v3.26.1
DATASTORE_TYPE=etcdv3
CNI_BIN_DIR=/opt/cni/bin
CALICOCTL_CFG=/etc/calico/calicoctl.cfg
export CNI_VERSION CALICO_DIR ETCD_ENDPOINTS CALICO_VERSION DATASTORE_TYPE CNI_BIN_DIR CALICOCTL_CFG PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION